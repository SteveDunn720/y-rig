{
    "version": "1.17",
    "alias": "mouth",
    "color": "#0052aa",
    "mute": false,
    "solo": false,
    "meta_data": {
        "positions": {
            "/bean_mouth": [
                -1011.9459426257373,
                318.98296017550416
            ]
        }
    },
    "nodes": {
        "/bean_mouth": {
            "instance": "/component",
            "child_order": [
                "build",
                "skin_surface"
            ],
            "attrs": {
                "control_parent": {
                    "type": "raw",
                    "value": "${component_group}"
                },
                "control_size": {
                    "type": "int",
                    "value": "2"
                },
                "name": {
                    "value": "mouth"
                },
                "parent": {
                    "type": "raw",
                    "value": "face_grp"
                }
            },
            "code": [
                "group = yrig.transform.create_transform(name=\"${component_group}\", parent=\"${parent}\")",
                "cmds.setAttr(f\"{group}.overrideEnabled\", True)",
                "cmds.setAttr(f\"{group}.drawOverride.overrideRGBColors\", True)",
                "cmds.connectAttr(\"${control_layer}.controlColor\", f\"{group}.drawOverride.overrideColorRGB\")"
            ]
        },
        "/bean_mouth/build": {
            "code": [
                "from yrig.component.bean_mouth import BeanMouth, BeanMouthGuides, BeanMouthLipGuides",
                "",
                "mouth_surface = \"face_surface\"",
                "",
                "left_corner_guide = \"mouth_corner_L\"",
                "right_corner_guide = \"mouth_corner_R\"",
                "",
                "upper_lip_guides = BeanMouthLipGuides(",
                "    lip_mid_left = \"upper_lip_mid_L\",",
                "    lip_mid =\"upper_lip_mid_M\",",
                "    lip_mid_right=\"upper_lip_mid_R\")",
                "lower_lip_guides = BeanMouthLipGuides(",
                "    lip_mid_left = \"lower_lip_mid_L\",",
                "    lip_mid = \"lower_lip_mid_M\",",
                "    lip_mid_right = \"lower_lip_mid_R\")",
                "    ",
                "mouth_guides = BeanMouthGuides(",
                "    mouth = \"mouth_M\",",
                "    jaw = \"jaw_M\",",
                "    left_corner = left_corner_guide,",
                "    right_corner = right_corner_guide,",
                "    upper_lip = upper_lip_guides,",
                "    lower_lip = lower_lip_guides,",
                ")",
                "",
                "with yrig.control.collect_controls() as component_controls:",
                "    mouth = BeanMouth(",
                "        guides=mouth_guides, ",
                "        mouth_surface=mouth_surface,",
                "        parent=\"${component_group}\",",
                "        control_parent=\"${control_parent}\", ",
                "        joint_parent=\"${joint_parent}\", ",
                "        control_size=${control_size}",
                "    )",
                "    ",
                "STAGE.control_list.extend(component_controls)"
            ]
        },
        "/bean_mouth/skin_surface": {
            "code": [
                "face_path = STAGE.face_path",
                "mouth_surface_skin = face_path / \"mouth_surface.yskin\"",
                "",
                "yrig.skin.skin_geometry(bind_joints=[\"face_jnt\", \"jaw_M_jnt\"], geometry=\"mouth_surface\")",
                "yrig.skin.import_skin_weights(filepath=mouth_surface_skin, geometry=\"mouth_surface\")"
            ]
        }
    }
}