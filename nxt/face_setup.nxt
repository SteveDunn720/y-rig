{
    "version": "1.17",
    "alias": "face_setup",
    "color": "#119985",
    "mute": false,
    "solo": false,
    "meta_data": {
        "positions": {
            "/cleanup": [
                977.0117312460196,
                -329.0142175037931
            ],
            "/setup": [
                -901.0,
                -363.0
            ]
        }
    },
    "nodes": {
        "/": {
            "attrs": {
                "asset_path": {
                    "type": "raw"
                },
                "dev_build": {
                    "type": "bool",
                    "value": "False"
                },
                "face_path": {},
                "guide_filepath": {
                    "type": "raw",
                    "value": "${asset_path}"
                },
                "guide_group": {
                    "type": "raw",
                    "value": "face_guide"
                }
            }
        },
        "/cleanup": {
            "code": [
                "if not ${dev_build}:",
                "    cmds.delete(\"${guide_group}\")"
            ]
        },
        "/setup": {
            "start_point": true,
            "child_order": [
                "load_guides"
            ],
            "code": [
                "from maya import cmds",
                "",
                "asset_path = yrig.build.context.get_asset_root()",
                "if asset_path is None:",
                "    raise RuntimeError(\"The asset root from the yrig.build.context hasn't been set. Please run a dev build of the rig you are working on before running the NXT graph directly.\")",
                "STAGE.asset_path = asset_path",
                "STAGE.face_path = asset_path / \"data/face\""
            ]
        },
        "/setup/load_guides": {
            "code": [
                "face_path = STAGE.face_path",
                "guide_path = face_path / \"guide.mb\"",
                "if not guide_path.exists():",
                "    raise RuntimeError(f\"There was no guide file found at {guide_path}\")",
                "    ",
                "imported_nodes = cmds.file(str(guide_path.resolve()), i=True, defaultNamespace=True, returnNewNodes=True)",
                "top_level_nodes = cmds.ls(imported_nodes, assemblies=True)",
                "if not top_level_nodes:",
                "    raise RuntimeError(\"No transforms found in imported guides!\")",
                "",
                "# Case 1: exactly one root transform",
                "if len(top_level_nodes) == 1:",
                "    top_level_node = top_level_nodes[0]",
                "    if cmds.nodeType(top_level_node) == \"transform\":",
                "        guide_grp = top_level_node",
                "    else:",
                "        guide_grp = cmds.group(top_level_node, name=\"${guide_group}\", world=True)",
                "    if guide_grp != \"${guide_group}\":",
                "        guide_grp = cmds.rename(guide_grp)",
                "else:",
                "    # Case 2: multiple top level transforms (we need to group them)",
                "    guide_grp = cmds.group(top_level_nodes, name=\"${guide_group}\", world=True) "
            ]
        }
    }
}